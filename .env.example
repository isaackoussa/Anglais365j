# Copie ce fichier en « .env » pour tester le compte, les e-mails et les rappels en local (npm run dev).
# En production, ces variables se règlent dans Netlify → Project configuration → Environment variables.

# Envoi des e-mails (code de connexion, rappels, bilans) via Brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Anglais 365
# Liste Brevo dans laquelle ranger les élèves (facultatif, numéro de la liste)
BREVO_LIST_ID=

# Clé de la console admin (/#/admin)
ADMIN_KEY=

# En local sans Brevo : les e-mails (et donc les codes) s'affichent dans le terminal
MAIL_DRY_RUN=1
